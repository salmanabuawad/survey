# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/kidsphere_survey?schema=public
# Hosted: append ?sslmode=require for Supabase/Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/kidsphere_survey?schema=public"

# Password for the admin dashboard at /admin. Use a long random string.
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# Signs the admin session cookie. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-openssl-rand-base64-48"

# Port the Next.js server listens on (the systemd unit sets this).
PORT=3020
